{
  "name": "@kovapdf/krutidev-unicode",
  "version": "1.0.0",
  "description": "Convert Kruti Dev 010 Hindi text to Unicode and back. Zero dependencies, ESM + CommonJS + types, with a small CLI. The engine behind kovapdf.com/kruti-dev-to-unicode.",
  "keywords": [
    "hindi",
    "kruti dev",
    "krutidev",
    "kruti-dev-010",
    "devanagari",
    "unicode",
    "converter",
    "kruti-to-unicode",
    "unicode-to-kruti",
    "mangal",
    "remington",
    "legacy font"
  ],
  "homepage": "https://www.kovapdf.com/kruti-dev-to-unicode",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KovaPDF/krutidev-unicode.git"
  },
  "bugs": {
    "url": "https://github.com/KovaPDF/krutidev-unicode/issues"
  },
  "license": "MIT",
  "author": "KovaPDF (https://www.kovapdf.com)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "krutidev-unicode": "bin/krutidev-unicode.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
